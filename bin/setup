#!/bin/bash

set -e

# run command at repo root
CURRENT_PATH=$PWD
if [ -d .git ]; then
  cd "$(git rev-parse --show-toplevel)"
fi

if ! type pnpm > /dev/null
then
  cat << EOF
Install Node.js 26 and pnpm 12 before running setup.
See https://nodejs.org and https://pnpm.io/installation.
EOF
  exit 1
fi

echo "copy config files"
if [ ! -f config.json ]; then
  cp config.json.example config.json
fi

if [ ! -f .sequelizerc ]; then
  cp .sequelizerc.example .sequelizerc
fi

echo "install packages"
pnpm install --frozen-lockfile

cat << EOF


Edit the following config file to setup CodiMD server and client.
Read more info at https://hackmd.io/c/codimd-documentation/%2Fs%2Fcodimd-configuration

* config.json           -- CodiMD config
* .sequelizerc          -- db config

EOF

# change directory back
cd "$CURRENT_PATH"
